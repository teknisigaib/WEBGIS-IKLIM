{
  "openapi": "3.0.3",
  "info": {
    "title": "API Publik WebGIS BMKG Kaltim",
    "description": "Dokumentasi OpenAPI untuk endpoint publik WebGIS Cuaca & Iklim BMKG Kaltim. Endpoint ini bersifat Read-Only dan dapat diakses tanpa autentikasi (tanpa API Key) oleh sistem eksternal maupun website utama.",
    "version": "1.0.0",
    "contact": {
      "name": "Tim IT BMKG APT Pranoto Samarinda"
    }
  },
  "servers": [
    {
      "url": "https://webgis.bmkgaptpranoto.com",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/v1/maps/latest": {
      "get": {
        "tags": [
          "Public Maps"
        ],
        "summary": "Mendapatkan Peta Terbaru",
        "description": "Mengembalikan data arsip peta yang paling terakhir kali di-generate oleh sistem. Jika parameter `category` tidak diisi, akan mengembalikan peta apapun yang paling baru masuk ke database.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Filter menggunakan kunci kategori peta (Contoh: `hari_tanpa_hujan`, `sebaran_hujan_harian`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mendapatkan data peta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapResponse"
                }
              }
            }
          },
          "404": {
            "description": "Data peta belum tersedia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/maps/search": {
      "get": {
        "tags": [
          "Public Maps"
        ],
        "summary": "Pencarian Peta Spesifik",
        "description": "Mencari arsip peta secara spesifik berdasarkan nama kategori dan teks periode waktu. Pencarian bersifat fleksibel karena menggunakan metode pencarian teks (kemiripan kata).",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Kunci kategori peta (Contoh: `sebaran_hujan_harian`, `hari_tanpa_hujan`).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "description": "Teks periode yang dicari. Bersifat *case insensitive* (Contoh: `18 September 2026`, `Dasarian I`, atau sekadar `September`).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil menemukan data peta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapResponse"
                }
              }
            }
          },
          "404": {
            "description": "Data peta dengan kriteria tersebut tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MapResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 142
              },
              "title": {
                "type": "string",
                "example": "Peta Hari Tanpa Hujan"
              },
              "category": {
                "type": "string",
                "example": "hari_tanpa_hujan"
              },
              "period": {
                "type": "string",
                "example": "Dasarian I September 2026"
              },
              "update_time": {
                "type": "string",
                "example": "18 September 2026"
              },
              "analysis_text": {
                "type": "string",
                "example": "Berdasarkan pantauan satelit dan pos hujan, sebagian besar wilayah Kalimantan Timur..."
              },
              "image_url": {
                "type": "string",
                "format": "uri",
                "example": "https://webgis.bmkgaptpranoto.com/static/png/hari_tanpa_hujan_DASARIAN_I_SEPTEMBER_2026_12345.png"
              },
              "geojson_url": {
                "type": "string",
                "format": "uri",
                "example": "https://webgis.bmkgaptpranoto.com/static/geojson/hari_tanpa_hujan_DASARIAN_I_SEPTEMBER_2026_12345.json"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "example": "Data peta untuk periode tersebut tidak ditemukan."
          }
        }
      }
    }
  }
}